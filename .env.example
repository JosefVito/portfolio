# Server only
RESEND_API_KEY=re_xxxxxxxxx
# Until a domain is verified in Resend, the onboarding@resend.dev sender only delivers to the
# email of the Resend account itself, so CONTACT_TO must be that address or every send fails.
CONTACT_TO=you@example.com
# Public
NEXT_PUBLIC_WHATSAPP=639150000000      # E.164 digits, no plus sign
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to 1 in tests to skip Resend
CONTACT_DRY_RUN=
